{
  "name": "motif-forge-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:audio": "tsc -p tsconfig.json --noEmit && node scripts/build-render-worker.mjs",
    "build:web": "tsc -p apps/web/tsconfig.json --noEmit && vite build --config apps/web/vite.config.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "generate:openapi": "python3 scripts/export_openapi.py && openapi-typescript /private/tmp/motif-forge-openapi.json -o apps/web/src/generated/api-schema.d.ts",
    "smoke:s3": "node scripts/run_s3_browser_smoke.mjs",
    "smoke:s4": ".venv/bin/python -m scripts.run_s4_deterministic_smoke",
    "smoke:s5": ".venv/bin/python -m scripts.run_s5_deterministic_smoke",
    "smoke:s5:browser": "node scripts/run_s5_browser_smoke.mjs",
    "test:audio": "vitest run --exclude '**/._*' packages/audio-engine services/render-worker",
    "test:web": "vitest run --config apps/web/vitest.config.ts",
    "spike:audio": "node services/render-worker/dist/spike.js"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "playwright": "1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tone": "15.1.22"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "24.10.13",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "0.28.2",
    "jsdom": "^28.1.0",
    "openapi-typescript": "7.10.1",
    "typescript": "5.9.3",
    "vite": "^8.2.1",
    "vitest": "4.1.10"
  }
}
