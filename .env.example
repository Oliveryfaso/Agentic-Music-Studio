MOTIF_FORGE_ENVIRONMENT=development
MOTIF_FORGE_LOG_LEVEL=INFO
MOTIF_FORGE_API_HOST=0.0.0.0
MOTIF_FORGE_API_PORT=8000
MOTIF_FORGE_POSTGRES_DSN=postgresql://motif_forge:motif_forge@postgres:5432/motif_forge
MOTIF_FORGE_REDIS_URL=redis://redis:6379/0
MOTIF_FORGE_MEDIA_WORKER_QUEUE=media
MOTIF_FORGE_MEDIA_WORKER_SOFT_TIME_LIMIT_SECONDS=600
MOTIF_FORGE_MEDIA_WORKER_HARD_TIME_LIMIT_SECONDS=660
MOTIF_FORGE_MEDIA_JOB_LEASE_SECONDS=720
MOTIF_FORGE_OUTBOX_BATCH_SIZE=16
MOTIF_FORGE_OUTBOX_LEASE_SECONDS=60
MOTIF_FORGE_OUTBOX_POLL_INTERVAL_SECONDS=0.5

# Portable/CI/test fallback only. A local Lean profile should explicitly override
# both roots to the same external filesystem so promotion can use atomic rename.
MOTIF_FORGE_STORAGE_PROFILE=portable
MOTIF_FORGE_ARTIFACT_ROOT=./var/artifacts
MOTIF_FORGE_TEMP_ROOT=./var/tmp
MOTIF_FORGE_ARTIFACT_GLOBAL_QUOTA_BYTES=10737418240
MOTIF_FORGE_ARTIFACT_PROJECT_QUOTA_BYTES=2147483648
MOTIF_FORGE_TEMP_QUOTA_BYTES=2147483648
MOTIF_FORGE_UPLOAD_MAX_BYTES=268435456
MOTIF_FORGE_UPLOAD_PART_SIZE_BYTES=4194304
MOTIF_FORGE_UPLOAD_SESSION_TTL_HOURS=24
MOTIF_FORGE_STORAGE_MIN_FREE_BYTES=536870912
MOTIF_FORGE_PREVIEW_TTL_HOURS=24
MOTIF_FORGE_DERIVED_CACHE_TTL_HOURS=168
MOTIF_FORGE_TERMINAL_CHECKPOINT_TTL_HOURS=168

# Compose bind-mount source. Keep it on an external disk for local development.
# The portable fallback remains inside this repository, which is already on KINGSTON.
MOTIF_FORGE_ARTIFACT_HOST_ROOT=./var/artifacts

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
